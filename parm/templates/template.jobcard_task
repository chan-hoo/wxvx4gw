#!/bin/bash -l
{%- if sched == "slurm" %}
#SBATCH --account={{ account }}
#SBATCH --job-name={{ task_name }}
#SBATCH --output={{ output_name }}
  {%- if external_data %}
#SBATCH --partition={{ partition_queue_data }}
    {%- if platform == "gaea-c6" %}
#SBATCH --constraint={{ constraint_data }}
#SBATCH --cluster={{ cluster_data }}
    {%- endif %}
    {%- if native_data is not none %}
#SBATCH {{ native_data }}
    {%- endif %}
  {%- else %}
#SBATCH --partition={{ partition_queue }}
    {%- if platform == "gaea-c6" %}
#SBATCH --cluster={{ cluster }}
    {%- endif %}
    {%- if native is not none %}
#SBATCH {{ native }}
    {%- endif %}
  {%- endif %}
#SBATCH --qos={{ qos }}
#SBATCH --time={{ walltime }}
#SBATCH --nodes={{ nnodes }}
#SBATCH --ntasks-per-node={{ nprocs_per_node }}
  {%- if memory_flag %}
#SBATCH --mem={{ memory_per_node }}
  {%- endif %}
{%- elif sched == "pbspro" %}
#PBS -S /bin/bash
#PBS -A {{ account }}
#PBS -N {{ task_name }}
#PBS -o {{ output_name }}
#PBS -j oe
#PBS -q {{ partition_queue }}
#PBS -l walltime={{ walltime }}
#PBS -l select={{ nnodes }}:ncpus={{ nprocs_per_node }}:mpiprocs={{ nprocs_per_node }}
  {%- if native is not none %}
#PBS {{ native }}
  {%- endif %}
{%- endif %}

set -xue

# ---------------------------------------------------------------------
# Environment variables
# ---------------------------------------------------------------------
# Home directory
export HOMEwxvx={{ HOMEwxvx }}
# PDY/cyc
{%- if workflow_manager == "ecflow" %}
%include <head.h>
export PDY=%ECF_DATE%
export cyc=%CYC%
{%- else %}
export PDY="${PDY:-{{ pdy_cdate }}}"
export cyc="${cyc:-{{ cyc_cdate }}}"
{%- endif %}
# job/jobid
{%- if sched == "slurm" %}
export job="{{ task_name }}.${PDY}${cyc}"
export jobid="${job}.${SLURM_JOB_ID}"
{%- elif sched == "pbspro" %}
export job="{{ task_name }}.${PDY}${cyc}"
export jobid="${job}.${PBS_JOBID}"
{%- endif %}
# NCO variables
export envir="${envir:-{{ envir }}}"
export model_ver="${model_ver:-{{ model_ver }}}"
export KEEPDATA="${KEEPDATA:-{{ KEEPDATA }}}"
export OPSROOT="${OPSROOT:-{{ OPS_PATH }}/${envir}}"
export COMROOT="${COMROOT:-${OPSROOT}/com}"
export DATAROOT="${DATAROOT:-${OPSROOT}/tmp}"
export DCOMROOT="${DCOMROOT:-${OPSROOT}/dcom}"
# Intermediate calls for some NCO variables in J-job
export NET="${NET:-{{ NET }}}"
export RUN="${RUN:-{{ RUN }}}"
# Path to experimental case directory
export exp_case_path="{{ exp_case_path }}"

# ---------------------------------------------------------------------
# Load module file for task
# ---------------------------------------------------------------------
{%- if platform == "gaea-c6" %}
module reset
{%- else %}
module purge
{%- endif %}
source ${HOMEwxvx}/versions/run.ver_{{ platform }}
module use ${HOMEwxvx}/modulefiles
module load modules_{{ platform }}.intel
module list

# Activate conda environment
source ${HOMEwxvx}/sorc/activate_wxvx.sh

# ---------------------------------------------------------------------
# Run J-job script
# ---------------------------------------------------------------------
${HOMEwxvx}/jobs/JWXVX_{{ task_name_upper }}

{%- if workflow_manager == "ecflow" %}
%include <tail.h>
{%- endif %}
