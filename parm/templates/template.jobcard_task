#!/bin/bash -l
{%- if sched == "slurm" %}
#SBATCH --account={{ account }}
#SBATCH --job-name={{ task_name }}
#SBATCH --output={{ output_name }}
#SBATCH --partition={{ partition_queue }}
#SBATCH --qos={{ qos }}
#SBATCH --time={{ walltime }}
#SBATCH --nodes={{ nnodes }}
#SBATCH --ntasks-per-node={{ nprocs_per_node }}
  {%- if memory_flag %}
#SBATCH --mem={{ memory_per_node }}
  {%- endif %}
  {%- if native is not none %}
#SBATCH {{ native }}
  {%- endif %}
{%- elif sched == "pbspro" %}
#PBS -S /bin/bash
#PBS -A {{ account }}
#PBS -N {{ task_name }}
#PBS -o {{ output_name }}
#PBS -j oe
#PBS -q {{ partition_queue }}
#PBS -l walltime={{ walltime }}
#PBS -l select={{ nnodes }}:ncpus={{ nprocs_per_node }}:mpiprocs={{ nprocs_per_node }}
  {%- if native is not none %}
#PBS {{ native }}
  {%- endif %}
{%- endif %}

###########
set -xue
###########

## Export environment variables: task-specific
source {{ exp_case_path }}/task_env/{{ task_name }}.env

## Load module file for task
{%- if platform == "gaea-c6" %}
module reset
{%- else %}
module purge
{%- endif %}
#source {{ HOMEwxvx }}/versions/run.ver_{{ platform }}
module load nco
module list

## Environment variables
### PDY/cyc
{%- if workflow_manager == "ecflow" %}
%include <head.h>
export PDY=%ECF_DATE%
export cyc=%CYC%
{%- else %}
export PDY="${PDY:-{{ pdy_cdate }}}"
export cyc="${cyc:-{{ cyc_cdate }}}"
{%- endif %}
### job/jobid
{%- if sched == "slurm" %}
export job="{{ task_name }}.${PDY}${cyc}"
export jobid="${job}.${SLURM_JOB_ID}"
{%- elif sched == "pbspro" %}
export job="{{ task_name }}.${PDY}${cyc}"
export jobid="${job}.${PBS_JOBID}"
{%- endif %}

## Export environment variable: job-card level
source {{ HOMEwxvx }}/parm/jcard_env_setup.sh

#################################
## Run J-job script
#################################
{{ HOMEwxvx }}/jobs/JWXVX_{{ task_name_upper }}.sh

if [ -e "$pgmout" ]; then
  cat $pgmout
fi
if [ "${KEEPDATA}" = "NO" ]; then
  rm -rf ${DATA}
fi
date

{%- if workflow_manager == "ecflow" %}
%include <tail.h>
{%- endif %}
