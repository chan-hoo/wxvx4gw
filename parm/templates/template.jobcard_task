#!/bin/bash -l
{%- if sched == "slurm" %}
#SBATCH --account={{ account }}
#SBATCH --job-name={{ task_name }}
#SBATCH --output={{ output_name }}
#SBATCH --partition={{ partition_queue }}
#SBATCH --qos={{ qos }}
#SBATCH --time={{ walltime }}
#SBATCH --nodes={{ nnodes }}
#SBATCH --ntasks-per-node={{ nprocs_per_node }}
  {%- if memory_flag %}
#SBATCH --mem={{ memory_per_node }}
  {%- endif %}
  {%- if native is not none %}
#SBATCH {{ native }}
  {%- endif %}
{%- elif sched == "pbspro" %}
#PBS -S /bin/bash
#PBS -A {{ account }}
#PBS -N {{ task_name }}
#PBS -o {{ output_name }}
#PBS -j oe
#PBS -q {{ partition_queue }}
#PBS -l walltime={{ walltime }}
#PBS -l select={{ nnodes }}:ncpus={{ nprocs_per_node }}:mpiprocs={{ nprocs_per_node }}
  {%- if native is not none %}
#PBS {{ native }}
  {%- endif %}
{%- endif %}

set -xue

# ---------------------------------------------------------------------
# Environment variables
# ---------------------------------------------------------------------
# Home directory
export HOMEwxvx={{ HOMEwxvx }}
# PDY/cyc
{%- if workflow_manager == "ecflow" %}
%include <head.h>
export PDY=%ECF_DATE%
export cyc=%CYC%
{%- else %}
export PDY="${PDY:-{{ pdy_cdate }}}"
export cyc="${cyc:-{{ cyc_cdate }}}"
{%- endif %}
# job/jobid
{%- if sched == "slurm" %}
export job="{{ task_name }}.${PDY}${cyc}"
export jobid="${job}.${SLURM_JOB_ID}"
{%- elif sched == "pbspro" %}
export job="{{ task_name }}.${PDY}${cyc}"
export jobid="${job}.${PBS_JOBID}"
{%- endif %}

# ---------------------------------------------------------------------
# Load module file for task
# ---------------------------------------------------------------------
{%- if platform == "gaea-c6" %}
module reset
{%- else %}
module purge
{%- endif %}
source ${HOMEwxvx}/versions/run.ver_{{ platform }}
module load prod_util
module list

# ---------------------------------------------------------------------
# Run J-job script
# ---------------------------------------------------------------------
${HOMEwxvx}/jobs/JWXVX_{{ task_name_upper }}

{%- if workflow_manager == "ecflow" %}
%include <tail.h>
{%- endif %}
