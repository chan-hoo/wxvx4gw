#!/bin/bash -l
{%- if WORKFLOW_MANAGER != "rocoto" %}
  {%- if SCHED == "slurm" %}
#SBATCH --account={{ ACCOUNT }}
#SBATCH --job-name={{ task_name }}
#SBATCH --output={{ output_name }}
#SBATCH --partition={{ partition_queue }}
#SBATCH --qos={{ qos }}
#SBATCH --time={{ walltime }}
#SBATCH --nodes={{ nnodes }}
#SBATCH --ntasks-per-node={{ nprocs_per_node }}
    {%- if memory_flag %}
#SBATCH --mem={{ memory_per_node }}
    {%- endif %}
    {%- if NATIVE is not none %}
#SBATCH {{ NATIVE }}
    {%- endif %}
  {%- elif SCHED == "pbspro" %}
#PBS -S /bin/bash
#PBS -A {{ ACCOUNT }}
#PBS -N {{ task_name }}
#PBS -o {{ output_name }}
#PBS -j oe
#PBS -q {{ partition_queue }}
#PBS -l walltime={{ walltime }}
#PBS -l select={{ nnodes }}:ncpus={{ nprocs_per_node }}:mpiprocs={{ nprocs_per_node }}
    {%- if NATIVE is not none %}
#PBS {{ NATIVE }}
    {%- endif %}
  {%- endif %}
{%- endif %}

###########
set -xue
###########

## Export environment variables: task-specific
source {{ exp_case_path }}/task_env/{{ task_name }}.env

## Load module file for task
{%- if MACHINE == "gaeac6" %}
module reset
{%- else %}
module purge
{%- endif %}
source {{ HOMEufsda }}/versions/run.ver_{{ MACHINE }}
module use {{ HOMEufsda }}/modulefiles/tasks/{{ MACHINE }}
module load task.{{ task_name }}
module list

## Environment variables
### PDY/cyc
{%- if WORKFLOW_MANAGER == "ecflow" %}
%include <head.h>
export PDY=%ECF_DATE%
export cyc=%CYC%
{%- else %}
export PDY="${PDY:-{{ pdy_cdate }}}"
export cyc="${cyc:-{{ cyc_cdate }}}"
{%- endif %}
### job/jobid
{%- if SCHED == "slurm" %}
export job="{{ task_name }}.${PDY}${cyc}"
export jobid="${job}.${SLURM_JOB_ID}"
{%- elif SCHED == "pbspro" %}
export job="{{ task_name }}.${PDY}${cyc}"
export jobid="${job}.${PBS_JOBID}"
{%- endif %}

## Export environment variable: job-card level
source {{ HOMEufsda }}/parm/jcard_env_setup.sh

#################################
## Replacement of J-job script
#################################
source {{ HOMEufsda }}/parm/jjob_env_setup.sh

### Run task ex-script
{{ HOMEufsda }}/scripts/exufsda_{{ task_name }}.sh

if [ -e "$pgmout" ]; then
  cat $pgmout
fi
if [ "${KEEPDATA}" = "NO" ]; then
  rm -rf ${DATA}
fi
date

{%- if WORKFLOW_MANAGER == "ecflow" %}
%include <tail.h>
{%- endif %}
